---
import Base from "../layouts/Base.astro";
import MemberList from "../components/MemberList.astro";
import { ring, withBase } from "../lib/members";

const opmlHref = withBase("/feeds.opml");
---

<Base lang="pt" page="members" title={`Membros · ${ring.name}`} description="Todos os sites do webring, pela ordem em que a faixa os percorre.">
  <h1>Membros</h1>
  <p class="lead">Cada porta é um site.</p>
  <p>
    Usas um leitor de feeds? <a href={opmlHref} download>Descarrega o ficheiro OPML</a>
    com os feeds de todos os membros.
  </p>

  <MemberList lang="pt" />
</Base>
