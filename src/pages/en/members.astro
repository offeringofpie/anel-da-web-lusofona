---
import Base from "../../layouts/Base.astro";
import MemberList from "../../components/MemberList.astro";
import { ring, withBase } from "../../lib/members";

const opmlHref = withBase("/feeds.opml");
---

<Base lang="en" page="members" title={`Members · ${ring.name}`} description={`Every site in ${ring.name}, in the order the banner walks them.`}>
  <h1>Members</h1>
  <p class="lead">Each door is a site.</p>
  <p>
    Use a feed reader? <a href={opmlHref} download>Download the OPML file</a>
    with every member's feed.
  </p>

  <MemberList lang="en" />
</Base>
