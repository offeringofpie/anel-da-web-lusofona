---
type Props = {
  number: number;
  title: string;
  id?: string;
};

const { number, title, id } = Astro.props;

const iconSize = 16;
---

<details class="step" name="steps" id={id}>
  <summary>
    <h2><span class="number">{number}.</span> {title}</h2>
    <svg class="chevron" viewBox="0 0 16 16" width={iconSize} height={iconSize} aria-hidden="true">
      <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <slot />
</details>

<script>
  const target = document.getElementById(location.hash.slice(1));

  if (target instanceof HTMLDetailsElement) {
    target.open = true;
  }
</script>
